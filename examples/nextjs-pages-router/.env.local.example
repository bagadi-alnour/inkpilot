# Server-only AI keys (never NEXT_PUBLIC_* — those are exposed in the browser bundle)
SECRET_OPENAI_KEY=
SECRET_ANTHROPIC_KEY=
# Or: OPENAI_API_KEY= / ANTHROPIC_API_KEY=

# S3 — optional; editor resolves from env when unset
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
